# Frontend (Vite). Only non-secret values here: anything VITE_/NEXT_PUBLIC_ is visible in the browser.
# Local dev:
VITE_API_URL=http://localhost:5000/api
# Production, same domain (Express serves /api):
# VITE_API_URL=/api
# (NEXT_PUBLIC_API_URL is also honoured if you prefer that name.)

# Optional: must match PAYLOAD_SECRET on the backend if you override it.
# NEXT_PUBLIC_PAYLOAD_SECRET=
