{
  "name": "lucidmind-api",
  "version": "2.0.0",
  "type": "module",
  "description": "LucidMind backend API (Node.js + Express + MySQL)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch-path=src src/dev.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "seed:admin": "node --import ./scripts/devEnv.js scripts/seed-admin.js",
    "setup:db": "node --import ./scripts/devEnv.js scripts/setup-db.js",
    "seed:admin:prod": "node scripts/seed-admin.js",
    "setup:db:prod": "node scripts/setup-db.js",
    "migrate:mysql": "node scripts/migrate-to-mysql.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "mysql2": "^3.14.0",
    "nodemailer": "^7.0.0"
  },
  "devDependencies": {
    "supertest": "^7.1.0"
  }
}
