NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Local MySQL (XAMPP / MySQL installer / docker compose -f docker-compose.local.yml up -d)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=lucidmind
DATABASE_USER=root
DATABASE_PASSWORD=

JWT_SECRET=local-dev-secret-change-me

# Contact form (optional locally; without it /api/contact returns a configuration error)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=
SMTP_APP_PASSWORD=
RECEIVER_EMAIL=

UPLOAD_DIR=uploads
SERVE_FRONTEND=false
