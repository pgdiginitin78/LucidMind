NODE_ENV=production
# Hostinger injects PORT for Node apps; leave unset there. Only set for self-hosting.
# PORT=5000
FRONTEND_URL=https://lucidmind.co.in

# hPanel -> Databases -> MySQL Databases: use the exact host/name/user shown there
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=u123456789_lucidmind
DATABASE_USER=u123456789_lucidmind
DATABASE_PASSWORD=replace_me

# Required. Reuse the old PHP JWT_SECRET to keep existing admin sessions valid.
JWT_SECRET=replace_with_long_random_string

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=replace_me
RECEIVER_EMAIL=owner@example.com

# Persistent folder outside the deployed code so redeploys don't delete uploads
UPLOAD_DIR=/home/u123456789/lucidmind-uploads

# One Node app serves the site and /api (same domain)
SERVE_FRONTEND=true
FRONTEND_DIST_DIR=../frontend/dist
TRUST_PROXY=1
