NODE_ENV=production
PORT=5000
FRONTEND_URL=https://lucidmind.co.in

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=your_database_name
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password
# (legacy DB_HOST / DB_NAME / DB_USER / DB_PASSWORD / DB_PORT are still accepted)

# Required in production. Use a long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NOTE: tokens issued by the PHP backend stay valid only if this equals the old JWT_SECRET.
JWT_SECRET=change_me

# Must match NEXT_PUBLIC_PAYLOAD_SECRET at frontend build time (omit both to use the built-in default)
# PAYLOAD_SECRET=

# Contact form email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=you@example.com
SMTP_APP_PASSWORD=app_password_here
RECEIVER_EMAIL=owner@example.com,other@example.com

# Uploads: must be a persistent, writable directory (relative to backend/ or absolute)
UPLOAD_DIR=uploads

# Set true to let this Node app also serve the built frontend (single-app, same-domain deployment)
SERVE_FRONTEND=false
FRONTEND_DIST_DIR=../frontend/dist

# Number of reverse-proxy hops in front of Node (for correct client IPs in rate limiting)
TRUST_PROXY=1
