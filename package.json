
{
  "name": "lucidmind-root",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "postinstall": "npm run install:backend && npm run install:frontend && npm run build",
    "dev": "npm run dev --prefix frontend",
    "dev:api": "npm run dev --prefix backend",
    "install:frontend": "npm install --prefix frontend --include=dev",
    "install:backend": "npm install --prefix backend --omit=dev",
    "test:backend": "npm test --prefix backend",
    "start": "node server.js",
    "build": "npm run build --prefix frontend"
  }
}
